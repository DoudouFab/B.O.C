rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Filet de sécurité global : refus par défaut
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitives de validation et d'identité
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isControllerOwner(controllerId) {
      return isVerified() && isValidId(controllerId) && request.auth.uid == controllerId;
    }

    function isValidOptionalUrl(val) {
      return val is string && val.size() <= 500 && (
        val == '' ||
        val.matches('^https?://.*')
      );
    }

    function isValidHexColor(val) {
      return val is string && val.size() == 7 && val.matches('^#[0-9a-fA-F]{6}$');
    }

    function isValidDateStr(val) {
      return val is string && val.size() == 10 && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidEmailAddress(val) {
      return val is string && val.size() >= 3 && val.size() <= 254 && val.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }

    function isValidCalendarInviteEmails(arr) {
      return arr is list
        && arr.size() <= 3
        && (arr.size() < 1 || isValidEmailAddress(arr[0]))
        && (arr.size() < 2 || isValidEmailAddress(arr[1]))
        && (arr.size() < 3 || isValidEmailAddress(arr[2]));
    }

    function controllerDocExists(controllerId) {
      return exists(/databases/$(database)/documents/controllers/$(controllerId));
    }

    function validProjectRef(controllerId, projectId) {
      return isValidId(projectId) && (
        projectId == 'general' ||
        exists(/databases/$(database)/documents/controllers/$(controllerId)/projects/$(projectId))
      );
    }

    // 3. Schémas de validation (Anti-Update-Gap)
    function isValidControllerProfile(data, controllerId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'jtdUrl', 'inasepUrl', 'sitesnapUrl', 'linksLocked', 'boundAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'jtdUrl', 'inasepUrl', 'sitesnapUrl', 'linksLocked', 'calendarInviteEmails', 'boundAt', 'updatedAt'
        ])
        && data.uid is string && data.uid == controllerId && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (request.auth.token.email == null || data.email == request.auth.token.email)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && isValidOptionalUrl(data.jtdUrl)
        && isValidOptionalUrl(data.inasepUrl)
        && isValidOptionalUrl(data.sitesnapUrl)
        && data.linksLocked is bool
        && (!('calendarInviteEmails' in data) || isValidCalendarInviteEmails(data.calendarInviteEmails))
        && data.boundAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data, controllerId) {
      return data.keys().hasAll([
          'ownerUid', 'code', 'name', 'commune', 'color',
          'marcheTotalReviseEur', 'cumulEaValidesEur', 'eaEnCoursEur', 'eaEnCoursCoche', 'delaiRestantJours',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'code', 'name', 'commune', 'color',
          'marcheTotalReviseEur', 'cumulEaValidesEur', 'eaEnCoursEur', 'eaEnCoursCoche', 'delaiRestantJours',
          'startDate', 'contractualEndDate', 'estimatedEndDate',
          'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == controllerId && data.ownerUid == request.auth.uid
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 64
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 180
        && data.commune is string && data.commune.size() >= 1 && data.commune.size() <= 100
        && isValidHexColor(data.color)
        && data.marcheTotalReviseEur is number && data.marcheTotalReviseEur >= 0
        && data.cumulEaValidesEur is number && data.cumulEaValidesEur >= 0
        && data.eaEnCoursEur is number && data.eaEnCoursEur >= 0
        && data.eaEnCoursCoche is bool
        && data.delaiRestantJours is number && data.delaiRestantJours >= 0
        && (!('startDate' in data) || isValidDateStr(data.startDate))
        && (!('contractualEndDate' in data) || isValidDateStr(data.contractualEndDate))
        && (!('estimatedEndDate' in data) || isValidDateStr(data.estimatedEndDate))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTodo(data, controllerId) {
      return data.keys().hasAll([
          'ownerUid', 'projectId', 'title', 'priority', 'done', 'dueDate', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'projectId', 'title', 'details', 'priority', 'done', 'dueDate', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == controllerId && data.ownerUid == request.auth.uid
        && isValidId(data.projectId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 240
        && (!('details' in data) || (data.details is string && data.details.size() <= 1000))
        && data.priority in ['Haute', 'Normale', 'Basse']
        && data.done is bool
        && data.dueDate is string && data.dueDate.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCalendarEntry(data, controllerId) {
      return data.keys().hasAll([
          'ownerUid', 'projectId', 'date', 'title', 'details', 'entryType', 'source', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'projectId', 'date', 'title', 'details',
          'startTime', 'durationMinutes', 'allDay', 'location',
          'entryType', 'source', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == controllerId && data.ownerUid == request.auth.uid
        && isValidId(data.projectId)
        && isValidDateStr(data.date)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.details is string && data.details.size() <= 600
        && (!('startTime' in data) || (data.startTime is string && data.startTime.size() <= 5))
        && (!('durationMinutes' in data) || (data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 1440))
        && (!('allDay' in data) || data.allDay is bool)
        && (!('location' in data) || (data.location is string && data.location.size() <= 160))
        && data.entryType in ['Annotation', 'Intempérie', 'JC']
        && data.source in ['boc', 'project-controler']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotebook(data, controllerId) {
      return data.keys().hasAll([
          'ownerUid', 'projectId', 'title', 'content', 'pinned', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'projectId', 'title', 'content', 'color', 'pinned', 'createdAt', 'updatedAt'
        ])
        && data.ownerUid is string && data.ownerUid == controllerId && data.ownerUid == request.auth.uid
        && isValidId(data.projectId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 180
        && data.content is string && data.content.size() <= 25000
        && (!('color' in data) || isValidHexColor(data.color))
        && data.pinned is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Règles strictes par contrôleur (aucun accès croisé possible)
    match /controllers/{controllerId} {
      allow get: if isControllerOwner(controllerId);
      allow list: if false;

      allow create: if isControllerOwner(controllerId)
        && isValidControllerProfile(incoming(), controllerId)
        && incoming().boundAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isControllerOwner(controllerId)
        && isValidControllerProfile(incoming(), controllerId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().boundAt == existing().boundAt
        && incoming().updatedAt == request.time
        && (
          (existing().linksLocked == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['jtdUrl', 'inasepUrl', 'sitesnapUrl', 'linksLocked', 'updatedAt']))
          ||
          (existing().linksLocked == true
            && incoming().linksLocked == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']))
          ||
          (existing().linksLocked == true
            && incoming().linksLocked == true
            && existing().inasepUrl == 'https://doudoufab.github.io/Project-Controler-Fabien.PIRQUIN/'
            && incoming().inasepUrl == 'https://doudoufab.github.io/Project-Controler-V2/'
            && incoming().diff(existing()).affectedKeys().hasOnly(['inasepUrl', 'updatedAt']))
          ||
          (incoming().linksLocked == existing().linksLocked
            && incoming().diff(existing()).affectedKeys().hasOnly(['calendarInviteEmails', 'updatedAt']))
        );

      allow delete: if false;

      match /projects/{projectId} {
        allow get: if isControllerOwner(controllerId);
        allow list: if isVerified() && request.auth.uid == controllerId && resource.data.ownerUid == request.auth.uid;

        allow create: if isControllerOwner(controllerId)
          && isValidId(projectId)
          && isValidProject(incoming(), controllerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && controllerDocExists(controllerId);

        allow update: if isControllerOwner(controllerId)
          && isValidId(projectId)
          && isValidProject(incoming(), controllerId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'code', 'name', 'commune', 'color',
            'marcheTotalReviseEur', 'cumulEaValidesEur', 'eaEnCoursEur', 'eaEnCoursCoche', 'delaiRestantJours',
            'startDate', 'contractualEndDate', 'estimatedEndDate',
            'updatedAt'
          ]);

        allow delete: if isControllerOwner(controllerId) && isValidId(projectId);
      }

      match /todos/{todoId} {
        allow get: if isControllerOwner(controllerId);
        allow list: if isVerified() && request.auth.uid == controllerId && resource.data.ownerUid == request.auth.uid;

        allow create: if isControllerOwner(controllerId)
          && isValidId(todoId)
          && isValidTodo(incoming(), controllerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && controllerDocExists(controllerId)
          && validProjectRef(controllerId, incoming().projectId);

        allow update: if isControllerOwner(controllerId)
          && isValidId(todoId)
          && isValidTodo(incoming(), controllerId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['done', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['projectId', 'title', 'details', 'priority', 'done', 'dueDate', 'updatedAt'])
          );

        allow delete: if isControllerOwner(controllerId) && isValidId(todoId);
      }

      match /calendarEntries/{entryId} {
        allow get: if isControllerOwner(controllerId);
        allow list: if isVerified() && request.auth.uid == controllerId && resource.data.ownerUid == request.auth.uid;

        allow create: if isControllerOwner(controllerId)
          && isValidId(entryId)
          && isValidCalendarEntry(incoming(), controllerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && controllerDocExists(controllerId)
          && validProjectRef(controllerId, incoming().projectId);

        allow update: if isControllerOwner(controllerId)
          && isValidId(entryId)
          && isValidCalendarEntry(incoming(), controllerId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'projectId', 'date', 'title', 'details',
            'startTime', 'durationMinutes', 'allDay', 'location',
            'updatedAt'
          ]);

        allow delete: if isControllerOwner(controllerId) && isValidId(entryId);
      }

      match /notebooks/{noteId} {
        allow get: if isControllerOwner(controllerId);
        allow list: if isVerified() && request.auth.uid == controllerId && resource.data.ownerUid == request.auth.uid;

        allow create: if isControllerOwner(controllerId)
          && isValidId(noteId)
          && isValidNotebook(incoming(), controllerId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && controllerDocExists(controllerId)
          && validProjectRef(controllerId, incoming().projectId);

        allow update: if isControllerOwner(controllerId)
          && isValidId(noteId)
          && isValidNotebook(incoming(), controllerId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'projectId', 'title', 'content', 'color', 'pinned', 'updatedAt'
          ]);

        allow delete: if isControllerOwner(controllerId) && isValidId(noteId);
      }
    }
  }
}
