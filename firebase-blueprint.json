{
  "entities": {
    "ControllerProfile": {
      "title": "ControllerProfile",
      "description": "Profil unique et isolé d'un contrôleur B.O.C avec ses 3 liens applicatifs verrouillables.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "jtdUrl": { "type": "string", "maxLength": 500 },
        "inasepUrl": { "type": "string", "maxLength": 500 },
        "sitesnapUrl": { "type": "string", "maxLength": 500 },
        "linksLocked": { "type": "boolean" },
        "calendarInviteEmails": { "type": "array", "description": "0 à 3 adresses e-mail (Gmail/Outlook) pour les invitations rendez-vous." },
        "boundAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "jtdUrl", "inasepUrl", "sitesnapUrl", "linksLocked", "boundAt", "updatedAt"]
    },
    "Project": {
      "title": "Project",
      "description": "Chantier actif lié à Project-Controler avec couleur, dates Gantt et indicateurs financiers/délai.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "commune": { "type": "string", "minLength": 1, "maxLength": 100 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "marcheTotalReviseEur": { "type": "number" },
        "cumulEaValidesEur": { "type": "number" },
        "eaEnCoursEur": { "type": "number" },
        "eaEnCoursCoche": { "type": "boolean" },
        "delaiRestantJours": { "type": "number" },
        "startDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "contractualEndDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "estimatedEndDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "ownerUid",
        "code",
        "name",
        "commune",
        "color",
        "marcheTotalReviseEur",
        "cumulEaValidesEur",
        "eaEnCoursEur",
        "eaEnCoursCoche",
        "delaiRestantJours",
        "createdAt",
        "updatedAt"
      ]
    },
    "TodoItem": {
      "title": "TodoItem",
      "description": "Élément de To-Do liste du contrôleur.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 240 },
        "details": { "type": "string", "maxLength": 1000 },
        "priority": { "type": "string", "enum": ["Haute", "Normale", "Basse"] },
        "done": { "type": "boolean" },
        "dueDate": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "projectId", "title", "priority", "done", "dueDate", "createdAt", "updatedAt"]
    },
    "CalendarEntry": {
      "title": "CalendarEntry",
      "description": "Annotation B.O.C paramétrable (heure, durée, lieu) ou intempérie/JC synchronisée depuis Project-Controler.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "details": { "type": "string", "maxLength": 600 },
        "startTime": { "type": "string", "maxLength": 5 },
        "durationMinutes": { "type": "number" },
        "allDay": { "type": "boolean" },
        "location": { "type": "string", "maxLength": 160 },
        "entryType": { "type": "string", "enum": ["Annotation", "Intempérie", "JC"] },
        "source": { "type": "string", "enum": ["boc", "project-controler"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "projectId", "date", "title", "details", "entryType", "source", "createdAt", "updatedAt"]
    },
    "NotebookItem": {
      "title": "NotebookItem",
      "description": "Bloc-notes Post-it personnel du contrôleur.",
      "type": "object",
      "properties": {
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "projectId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "content": { "type": "string", "maxLength": 25000 },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "maxLength": 7 },
        "pinned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerUid", "projectId", "title", "content", "pinned", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/controllers/{controllerId}": {
      "schema": { "$ref": "#/entities/ControllerProfile" },
      "description": "Profil unique lié au compte du contrôleur et configuration verrouillée des 3 liens."
    },
    "/controllers/{controllerId}/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Chantiers actifs liés à Project-Controler (couleurs, planning Gantt, marché révisé, EA, délai)."
    },
    "/controllers/{controllerId}/todos/{todoId}": {
      "schema": { "$ref": "#/entities/TodoItem" },
      "description": "To-Do liste isolée par contrôleur."
    },
    "/controllers/{controllerId}/calendarEntries/{entryId}": {
      "schema": { "$ref": "#/entities/CalendarEntry" },
      "description": "Annotations calendrier paramétrées et intempéries/JC synchronisées depuis Project-Controler."
    },
    "/controllers/{controllerId}/notebooks/{noteId}": {
      "schema": { "$ref": "#/entities/NotebookItem" },
      "description": "Post-it / blocs-notes isolés par contrôleur."
    }
  }
}
